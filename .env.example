# --- Telegram ---------------------------------------------------------
# From @BotFather
BOT_TOKEN=123456789:AAExampleTokenTextGoesHere
# Public HTTPS URL of this app's /webhook route. Optional for local
# runs; set it in production so /set-webhook refuses a forged Host.
WEBHOOK_URL=https://yourdomain.com/webhook

# --- Web UI -----------------------------------------------------------
# @username shown on the page's "Open in Telegram" link
BOT_USERNAME=YourBotUsername
PORT=3000
HOST=0.0.0.0
# Scratch dir for downloaded media. Serverless platforms mount the app
# directory read-only — on Vercel set TEMP_DIR=/tmp (it also falls back
# to os.tmpdir() automatically if this dir can't be created).
TEMP_DIR=storage/temp

# --- Features ---------------------------------------------------------
# YouTube Data API v3 key (powers search)
GOOGLE_API_KEY=
CACHE_TTL=3600
# Lifetime of the YouTube download-menu buttons (seconds)
TOOL77_CACHE_TTL=3600
# Send-by-URL ceiling before falling back to download + multipart upload
MAX_URL_UPLOAD_BYTES=20971520
