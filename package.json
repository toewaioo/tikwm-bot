{
  "name": "yt-dl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "toewaioo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toewaioo/tikwm-bot.git"
  },
  "homepage": "https://github.com/toewaioo/tikwm-bot#readme",
  "bugs": {
    "url": "https://github.com/toewaioo/tikwm-bot/issues"
  },
  "description": "TikTok / Facebook / YouTube downloader — Telegram bot + web UI",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bunx tsx scripts/embed-view.ts && bunx tsx src/server.ts",
    "build": "bunx tsx scripts/embed-view.ts && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "embed": "bunx tsx scripts/embed-view.ts",
    "set-webhook": "bunx tsx bin/set-webhook.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
